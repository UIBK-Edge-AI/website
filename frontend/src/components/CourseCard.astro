---
import type { TeachingCourse } from '../lib/types';

interface Props {
  course: TeachingCourse;
}

const { course } = Astro.props;
---

<div class="card-glass course-card" data-semester={course.semester} data-degree={course.degree}>
  <!-- Full-width header with Degree on left and Semester on right -->
  <div class="course-header">
    <span class="badge badge-blue degree-badge">{course.degree.toUpperCase()}</span>
    <span class="badge badge-amber sem-badge">{course.semester}</span>
  </div>

  <h3 class="course-title">{course.title}</h3>

  <div class="course-meta">
    <div class="meta-item">
      <span class="meta-label">Instructors:</span>
      <span class="meta-value">{course.instructors}</span>
    </div>
    {course.room && (
      <div class="meta-item">
        <span class="meta-label">Location:</span>
        <span class="meta-value">{course.room}</span>
      </div>
    )}
  </div>

  <div class="course-footer">
    {course.redirect_to ? (
      <a href={course.redirect_to} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm lfu-btn">
        LFU Online &rarr;
      </a>
    ) : (
      <span class="tag-pill">University of Innsbruck</span>
    )}
  </div>
</div>

<style>
  .course-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Full-width header spanning across the card */
  .course-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 1rem;
    gap: 0.75rem;
  }

  /* Text inside bubbles centered vertically & horizontally */
  .degree-badge, .sem-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    box-sizing: border-box;
    vertical-align: middle;
  }

  .course-title {
    font-size: 1.18rem;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
    line-height: 1.3;
  }

  .course-meta {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.86rem;
    margin-bottom: 1.25rem;
  }

  .meta-item {
    display: flex;
    gap: 0.45rem;
    font-family: var(--font-mono);
  }

  .meta-label {
    color: var(--text-muted);
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .meta-value {
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .course-footer {
    border-top: 1px solid var(--border-color);
    padding-top: 0.85rem;
    margin-top: auto;
    display: flex;
    justify-content: flex-end;
  }

  .lfu-btn {
    font-size: 0.78rem;
  }
</style>
