---
const currentYear = new Date().getFullYear();

// Spam-proof email encoding
const groupEmail = 'edgeai-informatik@uibk.ac.at';
const emailParts = groupEmail.split('@');
const emailUserB64 = Buffer.from(emailParts[0]).toString('base64');
const emailDomainB64 = Buffer.from(emailParts[1]).toString('base64');
---

<footer class="site-footer">
  <div class="container footer-grid-2">
    <!-- Col 1: Contact & Location -->
    <div class="footer-col">
      <h4 class="col-title">Contact & Location</h4>
      <div class="contact-details">
        <p class="contact-line"><strong>Institution:</strong> Universität Innsbruck</p>
        <p class="contact-line"><strong>Address:</strong> Technikerstraße 21a, 6020 Innsbruck, Austria</p>
        <p class="contact-line">
          <strong>Email:</strong> 
          <a 
            href="#" 
            class="email-link spam-safe-email" 
            data-u={emailUserB64} 
            data-d={emailDomainB64}
            title="Contact Edge AI Group"
          >
            {emailParts[0]} [at] {emailParts[1]}
          </a>
        </p>
        <p class="contact-line"><strong>Phone:</strong> +43 512 507-53494</p>
        <div class="location-link-wrapper">
          <a href="https://www.uibk.ac.at/de/informatik/kontakt/anfahrt/" target="_blank" rel="noopener noreferrer" class="map-link">
            &rarr; Campus Map & Directions
          </a>
        </div>
      </div>
    </div>

    <!-- Col 2: Funding & Partners -->
    <div class="footer-col">
      <h4 class="col-title">Funding & Partners</h4>
      <div class="partner-showcase-box">
        <!-- Partners Consortium Logo (+150% bigger) -->
        <div class="partner-logo-plate">
          <img src="/images/logo/stiftung_edgeai.svg" alt="AIM AT Stiftungsprofessur Sponsors" class="partner-consortium-logo" />
        </div>
        <!-- UIBK Logo (Bigger) -->
        <div class="partner-uibk-wrap">
          <a href="https://www.uibk.ac.at/informatik/" target="_blank" rel="noopener noreferrer" title="University of Innsbruck Department of Computer Science">
            <img src="/images/logo/uibk_black.svg" alt="Universität Innsbruck" class="uibk-footer-logo uibk-dark-mode" />
            <img src="/images/logo/uibk_light.svg" alt="Universität Innsbruck" class="uibk-footer-logo uibk-light-mode" />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="copyright-text">&copy; {currentYear} Edge AI Research Group, University of Innsbruck. All rights reserved.</p>
    <div class="engineer-credit">
      <span>Developed by: </span>
      <a href="/team/tanim_gias" class="engineer-link">Tanim M. Rayhan Gias</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    margin-top: auto;
    padding-top: 4rem;
    padding-bottom: 2.5rem;
  }

  /* Exactly 2 Columns Grid */
  .footer-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-bottom: 3.5rem;
  }

  .col-title {
    font-size: 1.1rem;
    font-family: var(--font-heading);
    color: var(--text-primary);
    margin-bottom: 1.35rem;
    letter-spacing: 0.02em;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .contact-line {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .contact-line strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .email-link {
    color: var(--accent-cyan);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .email-link:hover {
    text-decoration: underline;
  }

  .location-link-wrapper {
    margin-top: 0.85rem;
  }

  .map-link {
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--accent-cyan);
    font-weight: 500;
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .map-link:hover {
    transform: translateX(3px);
  }

  /* Funding & Partners Box */
  .partner-showcase-box {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .partner-logo-plate {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: 1.15rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(245, 158, 11, 0.4);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35), 0 0 15px rgba(245, 158, 11, 0.15);
    max-width: 420px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .partner-logo-plate:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.45), 0 0 25px rgba(245, 158, 11, 0.25);
  }

  /* Partners Logo 150% Bigger */
  .partner-consortium-logo {
    max-height: 85px;
    width: 100%;
    object-fit: contain;
  }

  .partner-uibk-wrap {
    display: flex;
    align-items: center;
    margin-top: 0.25rem;
  }

  /* Bigger UIBK Logo */
  .uibk-footer-logo {
    height: 42px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .uibk-footer-logo:hover {
    opacity: 0.9;
    transform: scale(1.02);
  }

  .uibk-light-mode {
    display: none;
  }

  :global([data-theme="light"]) .uibk-dark-mode {
    display: none !important;
  }

  :global([data-theme="light"]) .uibk-light-mode {
    display: block !important;
  }

  /* Footer Bottom */
  .footer-bottom {
    border-top: 1px solid var(--border-color);
    padding-top: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.82rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .copyright-text {
    font-size: 0.82rem;
  }

  .engineer-credit {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
  }

  .engineer-link {
    color: var(--accent-cyan);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .engineer-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  @media (max-width: 850px) {
    .footer-grid-2 {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>

<script>
  // Client-side hydration for spam-safe emails
  document.querySelectorAll<HTMLAnchorElement>('.spam-safe-email').forEach((el) => {
    try {
      const u = atob(el.getAttribute('data-u') || '');
      const d = atob(el.getAttribute('data-d') || '');
      if (u && d) {
        const fullEmail = `${u}@${d}`;
        el.setAttribute('href', `mailto:${fullEmail}`);
        el.textContent = fullEmail;
      }
    } catch (e) {}
  });
</script>
