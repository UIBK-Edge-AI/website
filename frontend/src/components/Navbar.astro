---
const currentPath = Astro.url.pathname;
const cmsUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'http://localhost:8055';

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Team', href: '/team' },
  { 
    name: 'Teaching', 
    href: '/teaching',
    dropdown: [
      { name: 'Courses', href: '/teaching' },
      { name: 'Student Theses', href: '/teaching/theses' }
    ]
  },
  { name: 'Projects', href: '/projects' },
  { name: 'Publications', href: '/publications' },
  { name: 'Vacancies', href: '/vacancies' },
  { name: 'News', href: '/news' },
];
---

<header class="site-header">
  <div class="container header-container">
    <!-- Top Left: University of Innsbruck Logo linking to CS Department -->
    <div class="brand-group">
      <a 
        href="https://www.uibk.ac.at/informatik/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="uibk-nav-link" 
        title="Department of Computer Science, University of Innsbruck"
      >
        <!-- Dark Mode: uibk_black.svg (white text on dark) -->
        <img src="/images/logo/uibk_black.svg" alt="Universität Innsbruck" class="uibk-logo uibk-logo-dark" />
        <!-- Light Mode: uibk_light.svg (dark text on light) -->
        <img src="/images/logo/uibk_light.svg" alt="Universität Innsbruck" class="uibk-logo uibk-logo-light" />
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav">
      {navLinks.map((link) => (
        link.dropdown ? (
          <div class="nav-dropdown-wrapper">
            <a 
              href={link.href} 
              class={`nav-link ${currentPath.startsWith('/teaching') ? 'active' : ''}`}
            >
              {link.name}
              <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </a>
            <div class="dropdown-menu">
              {link.dropdown.map((sub) => (
                <a 
                  href={sub.href} 
                  class={`dropdown-item ${currentPath === sub.href ? 'active' : ''}`}
                >
                  {sub.name}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a 
            href={link.href} 
            class={`nav-link ${currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'active' : ''}`}
          >
            {link.name}
          </a>
        )
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Theme Toggle -->
      <button id="theme-toggle" class="icon-btn" aria-label="Toggle dark mode" title="Toggle theme">
        <svg id="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg id="sun-icon" style="display:none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <!-- CMS Login Button -->
      <a href={cmsUrl} target="_blank" rel="noopener noreferrer" class="login-btn" title="Login to CMS Portal">
        <svg class="login-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
          <polyline points="10 17 15 12 10 7"></polyline>
          <line x1="15" y1="12" x2="3" y2="12"></line>
        </svg>
        <span>Login</span>
      </a>

      <!-- Mobile Menu Toggle -->
      <button id="mobile-toggle" class="icon-btn mobile-only" aria-label="Open navigation menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="mobile-drawer">
    <div class="mobile-nav-links">
      <a href="https://www.uibk.ac.at/informatik/" target="_blank" class="mobile-nav-link" style="color: var(--accent-cyan); font-weight: 600;">
        &rarr; Dept. of Computer Science (UIBK)
      </a>
      {navLinks.map((link) => (
        link.dropdown ? (
          <div class="mobile-dropdown-group">
            <span class="mobile-group-title">{link.name}</span>
            {link.dropdown.map((sub) => (
              <a href={sub.href} class={`mobile-nav-link sub-link ${currentPath === sub.href ? 'active' : ''}`}>
                {sub.name}
              </a>
            ))}
          </div>
        ) : (
          <a href={link.href} class={`mobile-nav-link ${currentPath === link.href ? 'active' : ''}`}>
            {link.name}
          </a>
        )
      ))}
      <a href={cmsUrl} target="_blank" rel="noopener noreferrer" class="mobile-nav-link login-mobile-link">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
          <polyline points="10 17 15 12 10 7"></polyline>
          <line x1="15" y1="12" x2="3" y2="12"></line>
        </svg>
        <span>CMS Login &rarr;</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-color);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  /* Top Left Brand Group */
  .brand-group {
    display: flex;
    align-items: center;
  }

  .uibk-nav-link {
    display: flex;
    align-items: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
    text-decoration: none;
  }

  .uibk-nav-link:hover {
    transform: scale(1.03);
    opacity: 0.9;
  }

  .uibk-logo {
    height: 38px;
    width: auto;
    max-width: 170px;
    object-fit: contain;
  }

  /* Dark mode default: show uibk_black.svg (white letters) */
  .uibk-logo-dark {
    display: block;
  }
  .uibk-logo-light {
    display: none;
  }

  /* Light mode: show uibk_light.svg (dark blue letters) */
  :global([data-theme="light"]) .uibk-logo-dark {
    display: none !important;
  }
  :global([data-theme="light"]) .uibk-logo-light {
    display: block !important;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.2rem;
    position: relative;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--accent-cyan);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent-cyan);
    box-shadow: 0 0 8px var(--accent-cyan);
    border-radius: var(--radius-full);
  }

  .nav-dropdown-wrapper {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 170px;
    background: var(--bg-card);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.5rem;
    box-shadow: var(--shadow-lg);
    display: none;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-dropdown-wrapper:hover .dropdown-menu {
    display: flex;
  }

  .dropdown-item {
    font-size: 0.85rem;
    color: var(--text-secondary);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .dropdown-item:hover, .dropdown-item.active {
    background: rgba(0, 240, 255, 0.1);
    color: var(--accent-cyan);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .icon-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    border-radius: var(--radius-md);
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .icon-btn:hover {
    color: var(--accent-cyan);
    border-color: var(--border-highlight);
  }

  .login-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-primary);
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.25);
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .login-btn:hover {
    border-color: var(--accent-cyan);
    background: rgba(0, 240, 255, 0.18);
    color: var(--accent-cyan);
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.25);
  }

  .login-icon {
    color: var(--accent-cyan);
  }

  .mobile-only {
    display: none;
  }

  .mobile-drawer {
    display: none;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border-color);
    padding: 1.5rem;
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav-link {
    font-size: 1rem;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.4rem 0;
  }

  .mobile-nav-link.active {
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .mobile-group-title {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    text-transform: uppercase;
    margin-top: 0.5rem;
    display: block;
  }

  .mobile-nav-link.sub-link {
    padding-left: 1rem;
    font-size: 0.95rem;
  }

  .login-mobile-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    margin-top: 0.5rem;
    border-top: 1px solid var(--border-color);
    padding-top: 0.75rem;
  }

  @media (max-width: 880px) {
    .desktop-nav, .login-btn {
      display: none;
    }
    .mobile-only {
      display: flex;
    }
  }
</style>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const moonIcon = document.getElementById('moon-icon');
  const sunIcon = document.getElementById('sun-icon');

  function updateThemeUI(theme: string) {
    if (theme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
      if (moonIcon && sunIcon) {
        moonIcon.style.display = 'none';
        sunIcon.style.display = 'block';
      }
    } else {
      document.documentElement.removeAttribute('data-theme');
      if (moonIcon && sunIcon) {
        moonIcon.style.display = 'block';
        sunIcon.style.display = 'none';
      }
    }
  }

  const savedTheme = localStorage.getItem('theme') || 'dark';
  updateThemeUI(savedTheme);

  themeToggle?.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    const newTheme = currentTheme === 'light' ? 'dark' : 'light';
    localStorage.setItem('theme', newTheme);
    updateThemeUI(newTheme);
  });

  const mobileToggle = document.getElementById('mobile-toggle');
  const mobileDrawer = document.getElementById('mobile-drawer');

  mobileToggle?.addEventListener('click', () => {
    mobileDrawer?.classList.toggle('open');
  });

  // Automatically close drawer when a navigation link is clicked
  mobileDrawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileDrawer?.classList.remove('open');
    });
  });
</script>
