---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MemberCard from '../components/MemberCard.astro';
import { getSiteSettings, getProjects, getMembers, getNewsEvents } from '../lib/directus';

const settings = await getSiteSettings();
const allProjects = await getProjects();
const allMembers = await getMembers();
const news = await getNewsEvents();

const featuredProjects = allProjects.slice(0, 3);
const professorsAndPostdocs = allMembers.filter(m => ['PROFESSOR', 'POSTDOCTORAL RESEARCHERS'].includes(m.category)).slice(0, 4);

const topicIcons: Record<string, string> = {
  'Edge computing': '⚡',
  'Applied machine learning': '🧠',
  'Federated and embedded machine learning': '🌐',
  'Graph artificial intelligence': '🕸️',
  'Cloud and high-performance computing': '☁️',
  'Scheduling and resource management': '⏱️',
  'Compliance, ethics, sustainability': '🌱'
};

// Automatic seasonal calculation: April (month 3) to September (month 8) = Summer, else Winter
const currentMonth = new Date().getMonth();
const isSummerTime = currentMonth >= 3 && currentMonth <= 8;
const initialLogoSrc = isSummerTime ? '/images/logo/summer.png' : '/images/logo/winter1.png';
---

<BaseLayout title="Edge AI Research Group | University of Innsbruck">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content hero-content-centered">
        <!-- Edge AI Logo Centered Above Title (+50% Bigger) -->
        <div class="hero-logo-center-wrapper">
          <img 
            id="edgeai-logo-img"
            src={initialLogoSrc} 
            alt="Edge AI Research Group Logo" 
            class="hero-edgeai-logo-centered"
          />
        </div>

        <!-- Centered Dynamic Wave Title -->
        <h1 class="hero-title wave-text">
          EDGE ARTIFICIAL INTELLIGENCE
        </h1>

        <p class="hero-tagline">
          {settings.tagline || 'Smart Computing Where It Matters'}
        </p>

        <p class="hero-lead">
          Creating scalable, sustainable, and secure AI systems distributed on edge devices with limited capabilities, backed by powerful clouds and supercomputers.
        </p>

        <div class="hero-actions hero-actions-centered">
          <a href="/projects" class="btn btn-primary">
            Explore Research &rarr;
          </a>
          <a href="/team" class="btn btn-secondary">
            Meet the Team
          </a>
          <a href="/vacancies" class="btn btn-secondary">
            <span class="pulse-dot"></span> Open Positions
          </a>
        </div>
      </div>

      <div class="hero-carousel-wrapper">
        <HeroCarousel images={settings.carousel_images} />
      </div>
    </div>
  </section>

  <!-- Research Pillars Section -->
  <section class="section-py pillars-section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-cyan">Core Competencies</span>
        <h2 class="section-title">Research Focus Areas</h2>
        <p class="section-subtitle">
          Bridging the gap between edge devices, machine learning, distributed software engineering, and societal sustainability.
        </p>
      </div>

      <div class="grid-4 pillars-grid">
        {settings.research_topics.map((topic) => (
          <div class="card-glass topic-card">
            <div class="topic-icon">{topicIcons[topic] || '🔹'}</div>
            <h3 class="topic-title">{topic}</h3>
            <p class="topic-desc">
              Developing next-generation architectures and algorithmic foundations for {topic.toLowerCase()} on the computing continuum.
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Motivation & Mission Section (Full-Width Stacked Cards) -->
  <section class="section-py motivation-section">
    <div class="container motivation-stack">
      <!-- 1. Full-Width Our Mission Card -->
      <div class="card-glass motivation-card full-width-card">
        <div class="card-top-badge">
          <span class="badge badge-emerald">Our Mission</span>
        </div>
        <h2 class="motivation-title">Edge AI at the Computing Continuum</h2>
        <div class="motivation-body">
          <p>{settings.motivation}</p>
        </div>
        <div class="stats-row">
          <div class="stat-item">
            <span class="stat-number">12+</span>
            <span class="stat-label">Researchers</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">5+</span>
            <span class="stat-label">Active Grants</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">55+</span>
            <span class="stat-label">Publications</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">2025+</span>
            <span class="stat-label">Founded</span>
          </div>
        </div>
      </div>

      <!-- 2. Full-Width Endowment & Fancy Sponsorship Card -->
      <div class="card-glass funding-card full-width-card">
        <div class="funding-card-grid">
          <div class="funding-card-text-col">
            <div class="card-top-badge">
              <span class="badge badge-amber">Endowment</span>
            </div>
            <h2 class="funding-title">AIM AT Endowed Professorship</h2>
            <p class="funding-text">
              {settings.acknowledgments}
            </p>
            <div class="funding-actions">
              <a href="/projects/aimAtEdgeAI" class="btn btn-secondary btn-sm">
                About the Professorship &rarr;
              </a>
            </div>
          </div>

          <div class="funding-card-sponsor-col">
            <div class="sponsor-showcase-stage">
              <div class="sponsor-badge-tag">
                <span class="pulse-dot"></span>
                <span>Supported by FFG & Industrial Consortium</span>
              </div>
              <div class="funding-sponsor-plate">
                <img 
                  src="/images/logo/stiftung_edgeai.svg" 
                  alt="AIM AT Stiftungsprofessur Consortium Sponsors" 
                  class="funding-sponsor-logo" 
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Research Projects -->
  <section class="section-py projects-section">
    <div class="container">
      <div class="section-header-flex">
        <div>
          <span class="badge badge-blue">Key Initiatives</span>
          <h2 class="section-title">Featured Research Projects</h2>
        </div>
        <a href="/projects" class="btn btn-secondary">
          View All Projects ({allProjects.length}) &rarr;
        </a>
      </div>

      <div class="grid-3">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- Latest News & Highlights -->
  <section class="section-py news-section">
    <div class="container">
      <div class="section-header-flex">
        <div>
          <span class="badge badge-amber">Group Highlights</span>
          <h2 class="section-title">Latest News & Events</h2>
        </div>
        <a href="/news" class="btn btn-secondary">
          All News &rarr;
        </a>
      </div>

      <div class="grid-3">
        {news.map((item) => (
          <div class="card-glass news-card">
            {item.cover_image_path && (
              <div class="news-img-wrapper">
                <img src={item.cover_image_path} alt={item.title} class="news-img" />
              </div>
            )}
            <div class="news-body">
              <div class="news-meta">
                <span class="badge badge-cyan">{item.category}</span>
                <span class="news-date">{item.date}</span>
              </div>
              <h3 class="news-card-title">{item.title}</h3>
              <p class="news-summary">{item.summary}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    /* ==========================================================================
       CONTROL WAVE ANIMATION SPEED HERE:
       - Faster speed: 3.5s or 4s
       - Fast Turtle speed (Current): 6s
       - Slower Turtle speed: 8s or 10s
       ========================================================================== */
    --wave-speed: 6s;
  }

  .hero-section {
    padding-top: 3.5rem;
    padding-bottom: 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3.5rem;
  }

  /* Centered Hero Content */
  .hero-content-centered {
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Centered Logo Above Title (+50% Bigger) */
  .hero-logo-center-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  .hero-edgeai-logo-centered {
    height: 165px;
    width: auto;
    max-width: 360px;
    object-fit: contain;
    filter: drop-shadow(0 6px 28px rgba(0, 240, 255, 0.35));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .hero-edgeai-logo-centered:hover {
    transform: scale(1.04);
    filter: drop-shadow(0 8px 36px rgba(0, 240, 255, 0.55));
  }

  /* Centered Dynamic Left-to-Right Wave Color Title */
  .wave-text {
    font-size: 3.5rem;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-weight: 800;
    margin-bottom: 0.85rem;
    background: linear-gradient(
      90deg,
      #ffffff 0%,
      #00f0ff 25%,
      #3b82f6 50%,
      #a855f7 75%,
      #ffffff 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: waveColorFlow var(--wave-speed) linear infinite;
    display: inline-block;
  }

  :global([data-theme="light"]) .wave-text {
    background: linear-gradient(
      90deg,
      #0f172a 0%,
      #0284c7 25%,
      #2563eb 50%,
      #7c3aed 75%,
      #0f172a 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: waveColorFlow var(--wave-speed) linear infinite;
  }

  @keyframes waveColorFlow {
    0% {
      background-position: 0% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  .hero-tagline {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    color: var(--accent-cyan);
    margin-bottom: 1rem;
  }

  .hero-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 2rem;
    max-width: 780px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions-centered {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .hero-carousel-wrapper {
    width: 100%;
  }

  .section-header {
    margin-bottom: 2.5rem;
    text-align: center;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-header-flex {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: 2.2rem;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    font-size: 1.05rem;
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .topic-icon {
    font-size: 1.75rem;
  }

  .topic-title {
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .topic-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Full-Width Stacked Cards */
  .motivation-stack {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .full-width-card {
    width: 100%;
    padding: 2.75rem;
  }

  .card-top-badge {
    margin-bottom: 0.85rem;
  }

  .motivation-title {
    font-size: 1.95rem;
    margin-bottom: 1.25rem;
  }

  .motivation-body p {
    font-size: 1.08rem;
    line-height: 1.75;
    margin-bottom: 2.25rem;
    max-width: 1050px;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1.75rem;
    text-align: center;
  }

  .stat-number {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--accent-cyan);
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Endowment & Fancy Sponsorship Layout */
  .funding-card-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .funding-title {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  .funding-text {
    font-size: 1.02rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  /* Fancy & Catchy Sponsorship Showcase */
  .sponsor-showcase-stage {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sponsor-badge-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--accent-amber);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .funding-sponsor-plate {
    padding: 1.5rem 2rem;
    background: linear-gradient(145deg, #ffffff, #f4f6f8);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 25px rgba(245, 158, 11, 0.25);
    border: 2px solid rgba(245, 158, 11, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .funding-sponsor-plate::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
    transform: skewX(-25deg);
    animation: sponsorShine 5s infinite;
  }

  @keyframes sponsorShine {
    0%, 70% {
      left: -100%;
    }
    100% {
      left: 200%;
    }
  }

  .funding-sponsor-plate:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55), 0 0 35px rgba(245, 158, 11, 0.45);
    border-color: #f59e0b;
  }

  .funding-sponsor-logo {
    width: 100%;
    max-height: 130px;
    object-fit: contain;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.15));
  }

  .news-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }

  .news-img-wrapper {
    height: 180px;
    width: 100%;
    overflow: hidden;
  }

  .news-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .news-card:hover .news-img {
    transform: scale(1.05);
  }

  .news-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .news-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .news-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .news-card-title {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .news-summary {
    font-size: 0.88rem;
    line-height: 1.5;
  }

  @media (max-width: 992px) {
    .hero-edgeai-logo-centered { height: 130px; }
    .funding-card-grid { grid-template-columns: 1fr; gap: 2rem; }
    .stats-row { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
    .section-header-flex { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }

  @media (max-width: 640px) {
    .hero-section { padding-top: 2rem; padding-bottom: 2.5rem; }
    .hero-container { gap: 2.5rem; }
    .hero-edgeai-logo-centered { height: 100px; max-width: 220px; }
    .hero-actions-centered { flex-direction: column; width: 100%; }
    .hero-actions-centered .btn { width: 100%; }
    .full-width-card { padding: 1.35rem; }
    .motivation-title { font-size: 1.45rem; }
    .motivation-body p { font-size: 0.96rem; line-height: 1.6; }
    .funding-title { font-size: 1.35rem; }
    .funding-sponsor-plate { padding: 1rem; }
    .funding-sponsor-logo { max-height: 85px; }
    .stats-row { gap: 1rem; padding-top: 1.25rem; }
    .stat-number { font-size: 1.85rem; }
    .stat-label { font-size: 0.75rem; }
  }

  @media (max-width: 380px) {
    .stats-row { grid-template-columns: 1fr; }
    .hero-edgeai-logo-centered { height: 80px; max-width: 180px; }
  }
</style>

<script>
  // Automatic Seasonal Logo Switcher (April - Sept = Summer, Oct - March = Winter)
  const logoImg = document.getElementById('edgeai-logo-img') as HTMLImageElement;
  if (logoImg) {
    const month = new Date().getMonth();
    const isSummer = month >= 3 && month <= 8;
    logoImg.src = isSummer ? '/images/logo/summer.png' : '/images/logo/winter1.png';
  }
</script>
