---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemberCard from '../../components/MemberCard.astro';
import { getMembers } from '../../lib/directus';

const allMembers = await getMembers();

// Exact hierarchy ordering specified by user:
// PROFESSOR -> PhD STUDENTS -> UNDERGRADUATE STUDENTS -> POSTDOCTORAL RESEARCHERS -> SYSTEMS ENGINEER -> SECRETARY -> Alumni
const hierarchyOrder = [
  'PROFESSOR',
  'PHD STUDENTS',
  'UNDERGRADUATE STUDENTS',
  'POSTDOCTORAL RESEARCHERS',
  'SYSTEMS ENGINEER',
  'SECRETARY',
  'ALUMNI'
];

const sortedMembers = [...allMembers].sort((a, b) => {
  const catA = a.member_status === 'alumni' ? 'ALUMNI' : a.category;
  const catB = b.member_status === 'alumni' ? 'ALUMNI' : b.category;
  const rankA = hierarchyOrder.indexOf(catA) !== -1 ? hierarchyOrder.indexOf(catA) : 99;
  const rankB = hierarchyOrder.indexOf(catB) !== -1 ? hierarchyOrder.indexOf(catB) : 99;
  if (rankA !== rankB) return rankA - rankB;
  return a.lastname.localeCompare(b.lastname);
});

const categories = [
  { label: 'All Members', value: 'all' },
  { label: 'Professors', value: 'PROFESSOR' },
  { label: 'PhD Students', value: 'PHD STUDENTS' },
  { label: 'Undergraduate Students', value: 'UNDERGRADUATE STUDENTS' },
  { label: 'Postdoctoral Researchers', value: 'POSTDOCTORAL RESEARCHERS' },
  { label: 'Systems Engineering', value: 'SYSTEMS ENGINEER' },
  { label: 'Secretary', value: 'SECRETARY' },
  { label: 'Alumni', value: 'ALUMNI' }
];
---

<BaseLayout 
  title="Research Team" 
  description="Faculty, postdoctoral researchers, PhD students, and systems engineers in the Edge AI group at the University of Innsbruck."
>
  <div class="page-header">
    <div class="container">
      <span class="badge badge-cyan">People</span>
      <h1 class="page-title">Research Team</h1>
      <p class="page-subtitle">
        Meet our interdisciplinary group of professor, researchers, and systems engineers advancing edge intelligence.
      </p>
    </div>
  </div>

  <div class="container section-py" style="padding-top: 0;">
    <!-- Filter Navigation -->
    <div class="filter-nav" id="team-filter-nav">
      {categories.map((cat, idx) => (
        <button 
          class={`filter-btn ${idx === 0 ? 'active' : ''}`} 
          data-filter={cat.value}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Members Grid -->
    <div class="grid-3" id="members-grid">
      {sortedMembers.map((member) => (
        <div class="member-item-wrapper" data-category={member.category} data-status={member.member_status}>
          <MemberCard member={member} />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .member-item-wrapper {
    display: flex;
    flex-direction: column;
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('#team-filter-nav .filter-btn');
  const memberItems = document.querySelectorAll<HTMLElement>('.member-item-wrapper');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filterVal = btn.getAttribute('data-filter');

      memberItems.forEach((item) => {
        const itemCat = item.getAttribute('data-category');
        const itemStatus = item.getAttribute('data-status');

        if (filterVal === 'all') {
          item.style.display = 'flex';
        } else if (filterVal === 'ALUMNI') {
          item.style.display = (itemStatus === 'alumni' || itemCat === 'ALUMNI') ? 'flex' : 'none';
        } else {
          item.style.display = (itemCat === filterVal) ? 'flex' : 'none';
        }
      });
    });
  });
</script>
