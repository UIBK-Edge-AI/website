---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNewsEvents } from '../../lib/directus';

const news = await getNewsEvents();
---

<BaseLayout 
  title="News & Events | Edge AI Research Group" 
  description="Latest announcements, conference participation, seminars, and milestones from the Edge AI group at University of Innsbruck."
>
  <div class="page-header">
    <div class="container">
      <span class="badge badge-cyan">Dispatches</span>
      <h1 class="page-title">News & Events</h1>
      <p class="page-subtitle">
        Stay updated with our latest conference talks, media appearances, research awards, and campus activities.
      </p>
    </div>
  </div>

  <div class="container section-py" style="padding-top: 0;">
    <div class="news-layout">
      <!-- Main Feed -->
      <div class="news-feed">
        {news.map((item) => (
          <article class="card-glass news-article-card">
            {item.cover_image_path && (
              <div class="article-img-box">
                <img src={item.cover_image_path} alt={item.title} class="article-img" />
              </div>
            )}
            <div class="article-body">
              <div class="article-meta">
                <span class="badge badge-cyan">{item.category}</span>
                <span class="article-date">{item.date}</span>
              </div>
              <h2 class="article-title">{item.title}</h2>
              <p class="article-summary">{item.summary}</p>
              {item.external_url && (
                <div class="article-actions">
                  <a href={item.external_url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
                    Read External Article &rarr;
                  </a>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>

      <!-- Sidebar -->
      <div class="news-sidebar">
        <div class="card-glass linkedin-card">
          <h3 class="sidebar-title">LinkedIn Channel</h3>
          <p class="sidebar-desc">
            Follow our real-time research updates, student announcements, and conference check-ins on LinkedIn.
          </p>
          <a href="https://www.linkedin.com/school/universit%C3%A4t-innsbruck/" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-block">
            Follow on LinkedIn &rarr;
          </a>
        </div>

        <div class="card-glass media-inquiry-card">
          <h3 class="sidebar-title">Press & Media Inquiries</h3>
          <p class="sidebar-desc">
            For journalist questions, interview requests, or scientific commentary on edge computing and artificial intelligence:
          </p>
          <a href="mailto:edgeai-informatik@uibk.ac.at?subject=Press Inquiry" class="btn btn-secondary btn-sm btn-block">
            Contact Press Office &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .news-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2.5rem;
    align-items: start;
  }

  .news-feed {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .news-article-card {
    display: flex;
    gap: 2rem;
    padding: 1.75rem;
    align-items: center;
  }

  .article-img-box {
    width: 240px;
    height: 160px;
    border-radius: var(--radius-md);
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--border-color);
  }

  .article-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .news-article-card:hover .article-img {
    transform: scale(1.05);
  }

  .article-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .article-date {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .article-title {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
  }

  .article-summary {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .article-actions {
    margin-top: auto;
  }

  .news-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-title {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
  }

  .sidebar-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .btn-block {
    width: 100%;
  }

  @media (max-width: 900px) {
    .news-layout {
      grid-template-columns: 1fr;
    }
    .news-article-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .article-img-box {
      width: 100%;
      height: 220px;
    }
  }
</style>
