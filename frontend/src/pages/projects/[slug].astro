---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/directus';
import type { Project } from '../../lib/types';
import { marked } from 'marked';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Strip leading redundant heading from markdown body content
let rawContent = (project.content || project.summary || '').trim();
let leadingHeading = '';

const headingMatch = rawContent.match(/^##?\s+([^\n]+)\n*/);
if (headingMatch) {
  leadingHeading = headingMatch[1].trim();
  rawContent = rawContent.replace(/^##?\s+[^\n]+\n*/, '').trim();
}

const renderedContent = marked.parse(rawContent);

// Construct clean 2nd line title
const secondLineTitle = project.title || leadingHeading;
---

<BaseLayout 
  title={`${project.title} | Edge AI Projects`} 
  description={`${project.title} - Research project in the Edge AI group at University of Innsbruck.`}
>
  <div class="container section-py">
    <a href="/projects" class="back-link">&larr; Back to Projects</a>

    <div class="project-detail-layout">
      <!-- Main Content -->
      <div class="project-main-col">
        <div class="card-glass project-header-card">
          <div class="project-meta-badges">
            <span class={`badge ${project.project_status === 'ongoing' ? 'badge-emerald' : 'badge'}`}>
              {project.project_status}
            </span>
            {project.duration && (
              <span class="badge badge-cyan">{project.duration}</span>
            )}
            <span class="badge badge-amber">{project.sponsor}</span>
          </div>

          <h1 class="project-main-title">{project.name}</h1>
          <p class="project-main-sub">{secondLineTitle}</p>
        </div>

        <div class="card-glass project-content-card">
          <div class="content-text" set:html={renderedContent} />
        </div>
      </div>

      <!-- Single Unified Sidebar Card (No inside nested rectangle) -->
      <div class="project-sidebar-col">
        <div class="card-glass info-card">
          {project.cover_image_path && (
            <div class="project-logo-showcase">
              <img 
                src={project.cover_image_path} 
                alt={project.name} 
                class="project-cover-img"
                onerror="this.src='/images/logo/winter1.png'"
              />
            </div>
          )}

          {project.website && (
            <div class="sidebar-action">
              <a href={project.website} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-block">
                Official Project Site &rarr;
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-cyan);
    margin-bottom: 2rem;
    text-decoration: none;
  }

  .project-detail-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2.5rem;
    align-items: start;
  }

  .project-header-card {
    padding: 2.5rem;
    margin-bottom: 2rem;
  }

  .project-meta-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .project-main-title {
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
  }

  .project-main-sub {
    font-size: 1.15rem;
    color: var(--accent-cyan);
    font-weight: 500;
    line-height: 1.45;
  }

  .project-content-card {
    padding: 2.5rem;
  }

  .content-text {
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .content-text :global(h2) {
    font-size: 1.45rem;
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.4rem;
  }

  .content-text :global(h3) {
    font-size: 1.25rem;
    color: var(--accent-cyan);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .content-text :global(h4) {
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .content-text :global(p) {
    margin-bottom: 1.25rem;
  }

  .content-text :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .content-text :global(ul), .content-text :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .content-text :global(li) {
    margin-bottom: 0.5rem;
  }

  .content-text :global(blockquote) {
    border-left: 3px solid var(--accent-cyan);
    background: rgba(0, 240, 255, 0.05);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--text-primary);
  }

  .content-text :global(a) {
    color: var(--accent-cyan);
    text-decoration: underline;
  }

  .project-sidebar-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Single Unified Sidebar Card */
  .info-card {
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  /* Seamless Project Logo Display (No nested box, adapts to dark/light theme) */
  .project-logo-showcase {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 140px;
    padding: 0.5rem;
  }

  .project-cover-img {
    max-height: 130px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 16px rgba(0, 240, 255, 0.2));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  :global([data-theme="light"]) .project-cover-img {
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.08));
  }

  .project-cover-img:hover {
    transform: scale(1.05);
  }

  .sidebar-action {
    width: 100%;
  }

  .btn-block {
    width: 100%;
  }

  @media (max-width: 900px) {
    .project-detail-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .project-header-card, .project-content-card {
      padding: 1.35rem;
    }
    .info-card {
      padding: 1.5rem 1.25rem;
      gap: 1.5rem;
    }
    .project-cover-img {
      max-height: 100px;
    }
  }
</style>
